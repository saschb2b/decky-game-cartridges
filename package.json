{
  "name": "decky-game-cartridges",
  "version": "0.1.0",
  "description": "Game cartridges for Bazzite and SteamOS: USB SSDs that carry games between machines",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "decky",
    "plugin",
    "bazzite",
    "steamos",
    "usb",
    "cartridge"
  ],
  "author": "Saschb2b",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saschb2b/decky-game-cartridges.git"
  },
  "homepage": "https://github.com/saschb2b/decky-game-cartridges#readme",
  "bugs": "https://github.com/saschb2b/decky-game-cartridges/issues",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "packageManager": "pnpm@11.20.0"
}
